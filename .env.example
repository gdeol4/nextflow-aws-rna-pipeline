# ============================================================
# AWS Bulk RNA-seq Pipeline — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# These are referenced by nextflow.config, launch scripts, etc.
# NEVER commit the real .env to version control.
# ============================================================

# ---------------------------
# AWS General
# ---------------------------
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# ---------------------------
# S3 Bucket
# ---------------------------
# The single S3 bucket for all pipeline data
NF_BUCKET=your-rnaseq-bucket

# ---------------------------
# S3 Paths (derived from NF_BUCKET, listed for clarity)
# ---------------------------
# Nextflow scratch — lifecycle-managed, expires after 14 days
NF_WORKDIR=s3://your-rnaseq-bucket/platform/nextflow/work
# Nextflow run logs (timeline, trace, report)
NF_LOGDIR=s3://your-rnaseq-bucket/platform/nextflow/logs

# Human references (GENCODE v49, GRCh38 primary assembly)
HUMAN_FASTA=s3://your-rnaseq-bucket/refs/human/gencode49/GRCh38.primary_assembly.genome.fa.gz
HUMAN_GTF=s3://your-rnaseq-bucket/refs/human/gencode49/gencode.v49.primary_assembly.annotation.gtf.gz

# Mouse references (GENCODE M38, GRCm39 primary assembly)
MOUSE_FASTA=s3://your-rnaseq-bucket/refs/mouse/gencodeM38/GRCm39.primary_assembly.genome.fa.gz
MOUSE_GTF=s3://your-rnaseq-bucket/refs/mouse/gencodeM38/gencode.vM38.primary_assembly.annotation.gtf.gz

# Where raw FASTQs are uploaded
HUMAN_INBOX=s3://your-rnaseq-bucket/bulk/human/inbox
MOUSE_INBOX=s3://your-rnaseq-bucket/bulk/mouse/inbox

# Per-run samplesheets and configs
HUMAN_RUNS=s3://your-rnaseq-bucket/bulk/human/runs
MOUSE_RUNS=s3://your-rnaseq-bucket/bulk/mouse/runs

# Final pipeline output
HUMAN_RESULTS=s3://your-rnaseq-bucket/bulk/human/results
MOUSE_RESULTS=s3://your-rnaseq-bucket/bulk/mouse/results

# Cached Salmon index (reuse across runs via --save_reference)
HUMAN_REF_CACHE=s3://your-rnaseq-bucket/bulk/human/reference-cache
MOUSE_REF_CACHE=s3://your-rnaseq-bucket/bulk/mouse/reference-cache

# ---------------------------
# AWS Batch
# ---------------------------
# Compute environment name (the managed CE you created)
BATCH_COMPUTE_ENV=nextflow-ondemand-ce

# Job queue name (Nextflow submits jobs here)
BATCH_QUEUE=nextflow-queue

# Max vCPUs for the compute environment (controls max parallelism / cost ceiling)
BATCH_MAX_VCPUS=128

# ---------------------------
# IAM Roles
# ---------------------------
# Instance profile ARN for Batch worker EC2 instances
# (wraps ecsInstanceRole — has ECS agent perms + S3 access)
BATCH_INSTANCE_PROFILE_ARN=arn:aws:iam::123456789012:instance-profile/ecsInstanceRole

# Job/task role ARN for containerized Batch jobs (scoped S3 access)
# Leave empty for v1 if relying on instance role only
BATCH_JOB_ROLE_ARN=arn:aws:iam::123456789012:role/nextflowJobRole

# Runner EC2 instance profile (has S3 + Batch + PassRole + CloudWatch perms)
RUNNER_INSTANCE_PROFILE_ARN=arn:aws:iam::123456789012:instance-profile/nextflowRunnerRole

# ---------------------------
# Networking
# ---------------------------
# VPC ID
NF_VPC_ID=vpc-0123456789abcdef0

# Subnet IDs for Batch workers (private subnets, comma-separated)
BATCH_SUBNET_IDS=subnet-aaaaaaaaaaaaa,subnet-bbbbbbbbbbbbb

# Subnet ID for the runner EC2 (public subnet or private+SSM)
RUNNER_SUBNET_ID=subnet-ccccccccccccc

# Security group for Batch workers (outbound 443 only)
BATCH_SECURITY_GROUP_ID=sg-0123456789abcdef0

# Security group for the runner EC2 (SSH inbound from your IP)
RUNNER_SECURITY_GROUP_ID=sg-0fedcba9876543210

# ---------------------------
# Batch Instance Types
# ---------------------------
# Comma-separated list of instance types for the compute environment
BATCH_INSTANCE_TYPES=c7i.4xlarge,m7i.4xlarge,r7i.4xlarge,c7i.8xlarge,m7i.8xlarge

# ---------------------------
# Pipeline Defaults
# ---------------------------
# nf-core/rnaseq version
NFCORE_RNASEQ_VERSION=3.24.0

# Pseudoaligner (salmon only, no rapid_quant, no STAR)
PSEUDO_ALIGNER=salmon

# ---------------------------
# Runner EC2 (informational — used by setup docs, not by Nextflow directly)
# ---------------------------
RUNNER_INSTANCE_TYPE=t3.small
RUNNER_AMI=al2023-ami-kernel-default-x86_64
RUNNER_KEY_PAIR=your-key-pair-name
